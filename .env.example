# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Google Desktop app OAuth JSON file (keep the file outside the repository).
# GOOGLE_CALENDAR_CLIENT_SECRETS_FILE=C:\path\to\client_secret.json
# Optional token overrides; Hotmail still requires a supplied access token.
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# HOTMAIL_CALENDAR_ACCESS_TOKEN=

# Me calendar: retain its CA certificate outside the repository.
# ME_BASE=https://pop-os.local
# ME_CLIENT_ID=me-desktop
# ME_CA_FILE=C:\path\to\caddy-root.crt
# Optional calendar ID (otherwise use the first calendar returned by Me).
# ME_CALENDAR_ID=
# Optional token override (otherwise sign in and cache tokens in the OS store).
# ME_ACCESS_TOKEN=
